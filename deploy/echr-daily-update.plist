<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/run_daily_update.sh (with its apply flag) once a day at 18:30 (the Court's judgments of the day are on
  HUDOC by then; DOCX files HUDOC has not rendered yet are retried the next day). If the Mac is asleep
  at 18:30, launchd runs the job when it wakes.

  Install (replace the path with a checkout of main):
    sed "s#__REPO__#$HOME/path/to/ECHR-Dashboard#" deploy/echr-daily-update.plist \
      > ~/Library/LaunchAgents/org.hudoc-researcher.daily-update.plist
    launchctl load ~/Library/LaunchAgents/org.hudoc-researcher.daily-update.plist
  Run now:    launchctl start org.hudoc-researcher.daily-update
  Remove:     launchctl unload ~/Library/LaunchAgents/org.hudoc-researcher.daily-update.plist
  Logs:       ~/.echr-daily-update/logs/YYYY-MM-DD.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.hudoc-researcher.daily-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>__REPO__/scripts/run_daily_update.sh --apply</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>18</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/org.hudoc-researcher.daily-update.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/org.hudoc-researcher.daily-update.err</string>
</dict>
</plist>
